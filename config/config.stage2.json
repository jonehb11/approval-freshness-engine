{
  "_comment": "Runtime config for the Approval Freshness Engine. Validated by src/config/schema.ts at startup; any violation is a fail-closed startup error. Regex fields are strings; the /g and /y flags are rejected because a stateful lastIndex makes a security gate miss matches on alternate calls.",
  "difftasticBin": "difft",
  "selfGovernedRepos": [
    "jonehb11/approval-freshness-engine"
  ],
  "_comment_stage2": "STAGE 2 ENABLED. Used only by the Stage-2 validation deployment (AFE_CONFIG_PATH points here). The advisory classifier runs, but a PRESERVE still requires every deterministic corroboration gate below to agree.",
  "stage2Enabled": true,
  "denylist": {
    "paths": [
      "**/*.tf",
      "**/*.tfvars",
      "**/prod/**",
      "**/production/**",
      ".github/workflows/**",
      ".github/actions/**",
      "**/CODEOWNERS",
      "**/Dockerfile",
      "**/docker-compose*.yml",
      "**/*.tfstate",
      "**/iam/**",
      "**/*policy*.json",
      "**/package.json",
      "**/requirements.txt",
      "**/go.mod",
      "**/Gemfile",
      "**/pom.xml",
      "**/build.gradle",
      "**/Chart.yaml",
      "**/values.yaml",
      "**/*.pem",
      "**/*.key",
      "**/.env",
      "**/.env.*",
      "**/*secrets*",
      "**/*credentials*",
      "**/id_rsa*",
      "**/*.p12",
      "**/*.pfx",
      "**/*.jks",
      "**/*.keystore",
      "**/.github/workflows/**",
      "**/.github/actions/**",
      "**/.gitlab-ci.yml",
      "**/Jenkinsfile",
      "**/.circleci/**",
      "**/.buildkite/**"
    ]
  },
  "codeownersGlobs": [],
  "trivialClasses": {
    "docs": [
      "**/*.md",
      "**/*.mdx",
      "**/*.rst",
      "**/*.txt",
      "**/*.adoc"
    ],
    "lockfiles": {
      "files": [
        "**/package-lock.json",
        "**/yarn.lock",
        "**/pnpm-lock.yaml",
        "**/go.sum"
      ],
      "requireBotAuthor": [
        "dependabot[bot]",
        "renovate[bot]"
      ]
    },
    "generated": {
      "files": [
        "**/*.pb.go",
        "**/*_generated.go",
        "**/*.gen.ts"
      ],
      "requireDeterministicRegen": true,
      "requireBotAuthor": [
        "dependabot[bot]",
        "renovate[bot]",
        "github-actions[bot]"
      ]
    }
  },
  "injectionCanaries": [
    "/impact:\\s*low/i",
    "/ignore (all )?previous/i",
    "/classifier:/i",
    "/mark this (as )?(low|safe|trivial)/i",
    "/disregard (the )?(above|prior)/i",
    "/you are an? (ai|assistant|model)/i",
    "/system prompt/i"
  ],
  "sensitivePatterns": [
    "/\\b(password|passwd|secret|token|credential|jwt|hmac|authenticate|authorize)\\b/i",
    "/\\b(eval|exec|execSync|deserialize|pickle|unserialize)\\b/i",
    "/\\bfetch\\(|axios|http\\.|requests\\./i",
    "/\\b(chmod|sudo|setuid)\\b/i"
  ],
  "thresholds": {
    "confThreshold": 0.85,
    "softMaxLines": 40,
    "softMaxFiles": 5,
    "hardMaxLines": 400,
    "hardMaxFiles": 20,
    "modelTimeoutMs": 8000,
    "stalePendingMs": 900000
  }
}